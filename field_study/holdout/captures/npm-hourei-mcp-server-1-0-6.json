{
  "description": "MCP server for Japanese law information using e-Gov API",
  "ecosystem": "npm",
  "harvest_status": "harvested",
  "launch_argv": [
    "npx",
    "-y",
    "hourei-mcp-server@1.0.6"
  ],
  "manifest_sha256": "5fcf1a31dddc8f77e34fd5b3e21a8ff63eed9ab88871e189412e82aaa0f220c7",
  "package": "hourei-mcp-server",
  "protocol_version": "2024-11-05",
  "repository_url": "https://github.com/groundcobra009/hourei-mcp-server",
  "slug": "npm-hourei-mcp-server-1-0-6",
  "stderr_summary": "npm WARN deprecated node-domexception@1.0.0: Use your platform's native DOMException instead\n法令MCP Server running on stdio",
  "tool_count": 3,
  "tools": [
    {
      "description": "法令名や法令番号で法令を検索します。キーワード検索に対応しています。",
      "inputSchema": {
        "properties": {
          "category": {
            "description": "法令の種別（1:法律、2:政令、3:省令など）",
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5"
            ],
            "type": "string"
          },
          "keyword": {
            "description": "検索キーワード（法令名の一部や法令番号）",
            "type": "string"
          },
          "limit": {
            "default": 100,
            "description": "取得する最大件数（デフォルト: 100）",
            "type": "number"
          }
        },
        "required": [
          "keyword"
        ],
        "type": "object"
      },
      "name": "search_law"
    },
    {
      "description": "法令番号を指定して法令の詳細データを取得します。",
      "inputSchema": {
        "properties": {
          "lawNum": {
            "description": "法令番号（例: 平成十七年法律第百十七号）",
            "type": "string"
          }
        },
        "required": [
          "lawNum"
        ],
        "type": "object"
      },
      "name": "get_law_data"
    },
    {
      "description": "法令の改正履歴を取得します。",
      "inputSchema": {
        "properties": {
          "lawNum": {
            "description": "法令番号（例: 平成十七年法律第百十七号）",
            "type": "string"
          }
        },
        "required": [
          "lawNum"
        ],
        "type": "object"
      },
      "name": "get_law_revision"
    }
  ],
  "version": "1.0.6"
}
