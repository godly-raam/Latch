      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Search icons"
      },
      "description": "Search icons by name or tags. Exact name and tag matches rank first. Each result includes its JavaScript export name. Search for every icon you need in ONE call by separating the terms with commas (e.g. 'home, notification, settings') — far cheaper than one call per icon.",
      "inputSchema": {
        "properties": {
          "include_tags": {
            "description": "Include each icon's tags. Off by default — tags roughly triple the response and ranking already accounts for them. Only turn this on to compare icons that look equally plausible",
            "type": "boolean"
          },
          "limit": {
            "description": "Maximum results per search. Defaults to 8; lower it to 1-3 when you know what you want",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "What to search for. Separate multiple searches with commas, up to 10 per call",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "search_icons",
      "outputSchema": {
        "properties": {
          "searches": {
            "items": {
              "properties": {
                "error": {
                  "description": "Present when this term's search failed. Its results are empty because the lookup broke, not because the icon is missing — search the term again on its own",
                  "type": "string"
                },
                "fuzzy": {
                  "description": "True when nothing matched closely and these are best guesses",
                  "type": "boolean"
                },
                "query": {
                  "type": "string"
                },
                "results": {
                  "items": {
                    "properties": {
                      "category": {
                        "type": "string"
                      },
                      "component": {
                        "description": "Export name in the JavaScript packages",
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "tags": {
                        "description": "Only present when include_tags is true",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "name",
                      "component",
                      "category"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "total": {
                  "description": "Relevant matches before the limit",
                  "type": "integer"
                }
              },
              "required": [
                "query",
                "total",
                "fuzzy",
                "results"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "searches"
        ],
        "type": "object"
